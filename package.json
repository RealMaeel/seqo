{
  "name": "seqo",
  "productName": "SEQO",
  "version": "2.5.2",
  "description": "SEQO - Simple EQ Overlay for EverQuest Legends",
  "main": "main.js",
  "author": "Ed",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/parser.test.js && node test/worldmap.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ed.seqo",
    "productName": "SEQO",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SEQO-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SEQO-Portable-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "parser.js",
      "posquests.js",
      "unlocks.js",
      "epics.js",
      "bis.js",
      "updater.js",
      "zones.js",
      "worldmap.js",
      "buffs.js",
      "slayer.js",
      "spellquests.js",
      "spelldb.js",
      "overlay.html",
      "dock.html",
      "needs.html",
      "assets/**"
    ]
  }
}